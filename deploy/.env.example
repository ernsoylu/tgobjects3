# TGOBJECTS3 deployment configuration (Requirement 1).
#
# Copy this file to `.env` in the same directory, then fill in the required
# values before running `docker compose up`. Variables consumed by the gateway
# map one-to-one to gateway/app/config.py (Settings); the POSTGRES_* and
# *_PORT / *_URL values are consumed by docker-compose.yml.
#
#   cp .env.example .env

# --- Required (gateway refuses to start without these — Requirement 1.3) ---

# Root symmetric key that wraps every per-bucket KEK. Minimum 16 characters.
# Generate a strong random value, e.g.: openssl rand -base64 48
TGOS3_MASTER_KEY=change-me-to-a-strong-secret

# SQLAlchemy/asyncpg URL for the index. The default targets the `postgres`
# compose service with the credentials below; change the user/password/db here
# AND in the POSTGRES_* block if you customise them.
DATABASE_URL=postgresql+asyncpg://tgobjects3:tgobjects3@postgres:5432/tgobjects3

# --- PostgreSQL service credentials ----------------------------------------
POSTGRES_USER=tgobjects3
POSTGRES_PASSWORD=tgobjects3
POSTGRES_DB=tgobjects3

# --- Published ports (host side) -------------------------------------------
# S3 API and Admin API ports. Container-internal ports stay 9000 / 8080.
S3_PORT=9000
ADMIN_PORT=8080
# Host port the static Console is published on (nginx listens on 80 inside).
CONSOLE_PORT=8081

# --- Console wiring ---------------------------------------------------------
# Where the Console reaches the gateway's Admin API on the compose network.
ADMIN_API_URL=http://gateway:8080

# --- Optional gateway tuning (see gateway/app/config.py for all settings) ---
# S3_REGION=us-east-1
# CHUNK_RECORDS=512
# STAGING_MAX_SIZE=16GiB
# CACHE_MAX_SIZE=4GiB
# UPLOAD_CONCURRENCY=2
